# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_PASSWORD=

# --- Entra ID SSO (interactive login app registration) ---
# IMPORTANT: leave these three lines OUT of .env entirely until you have a real app
# registration. An empty env var still overrides appsettings.Development.json's placeholder
# GUIDs (env vars win over appsettings*.json), which crashes Microsoft.Identity.Web on every
# request with "IDX10106: The 'ClientId' option must be provided."
# AzureAd__TenantId=
# AzureAd__ClientId=
# AzureAd__ClientSecret=

# --- Microsoft Graph (separate app-only/client-credentials app registration) ---
GraphAppOnly__TenantId=
GraphAppOnly__ClientId=
GraphAppOnly__ClientSecret=

# --- Jenkins ---
Jenkins__Username=
Jenkins__ApiToken=
Jenkins__CallbackSharedSecret=

# --- Azure Automation ---
AzureAutomation__TenantId=
AzureAutomation__ClientId=
AzureAutomation__ClientSecret=
AzureAutomation__CallbackSharedSecret=

# --- Local fallback admin (seeded once, on first run with an empty LocalAdminAccounts table) ---
OPSCENTRAL_LOCAL_ADMIN_USERNAME=
OPSCENTRAL_LOCAL_ADMIN_PASSWORD=
