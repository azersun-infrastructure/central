    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "GraphAppOnly": {
    "TenantId": "",
    "ClientId": ""
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=opscentral;Username=opscentral_user;Password=CHANGE_ME",
    "SqliteConnection": "Data Source=opscentral.db"
  },
  "UseDatabase": "Sqlite",

  "Jenkins": {
    "BaseUrl": "https://jenkins.sgofc.com",
    "Username": "",
    "Jobs": {
      "Unlock": "AD-User-Unlock",
      "Disable": "AD-User-Disable",
      "Enable": "AD-User-Enable",
      "Search": "AD-User-Search",
      "SendLocked": "AD-User-SendLocked",
      "SyncAd": "AD-Sync"
    }
  },

  "AzureAutomation": {
    "AutomationAccountResourceId": "",
    "TenantId": "",
    "ClientId": "",
    "WebhookUrls": {
      "Unlock": "",
      "Disable": "",
      "Enable": "",
      "Search": "",
      "SendLocked": "",
      "SyncAd": ""
    }
  },

  "AdActionRouting": {
    "Unlock": "Jenkins",
    "Disable": "Jenkins",
    "Enable": "Jenkins",
    "Search": "AzureAutomation",
    "SendLocked": "Jenkins",
    "SyncAd": "AzureAutomation"
  },

  "Reconciliation": {
    "PollIntervalSeconds": 30,
    "JobTimeoutSeconds": 180,
    "MaxPollAttempts": 20
  },

  "LocalAdminFallback": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },

  "Dispatch": {
    "UseMock": false
