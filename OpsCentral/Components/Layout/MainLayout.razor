@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app-layout">
    <NavMenu />

    <div class="main-content">
        <div class="top-bar">
            <div class="breadcrumb">Pages / User Management</div>
            <div class="top-bar-actions">
                <button type="button" class="theme-toggle-btn" @onclick="ToggleThemeAsync">
                    @(_isDark ? "☀️ Light" : "🌙 Dark")
                </button>
                <AuthorizeView>
                    <Authorized>
                        <div class="user-badge">
                            Signed in as <strong>@context.User.Identity?.Name</strong>
                            <form method="post" action="/Account/Logout" data-enhance-nav="false" style="display:inline">
                                <button type="submit" class="link-button">Sign out</button>
                            </form>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        @Body
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var current = await JS.InvokeAsync<string>("ocTheme.get");
            _isDark = current == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("ocTheme.set", _isDark ? "dark" : "light");
    }
}
