@namespace OpsCentral.Components.Pages.UserManagementParts
@using System.Text.Json
@using OpsCentral.Models.Entities
@inject IJSRuntime JS

@if (Visible && Request is not null)
{
    <div class="modal-overlay" @onclick="() => OnClose.InvokeAsync()">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@Request.ActionType — @Request.Input</h3>
                <button class="link-button" @onclick="() => OnClose.InvokeAsync()">✕</button>
            </div>

            <dl class="modal-summary">
                <dt>Status</dt>
                <dd><span class="status-badge status-@Request.Status.ToLowerInvariant()">@Request.Status</span></dd>
                <dt>Requested by</dt>
                <dd>@Request.RequestedByUpnOrUsername (@Request.RequestedByAuthSource)</dd>
                <dt>Dispatch target</dt>
                <dd>@Request.DispatchTarget</dd>
                @if (!string.IsNullOrEmpty(Request.ExternalJobUrl))
                {
                    <dt>External job</dt>
                    <dd><a href="@Request.ExternalJobUrl" target="_blank" rel="noopener">@Request.ExternalJobUrl</a></dd>
                }
                @if (!string.IsNullOrEmpty(Request.ErrorDetail))
                {
                    <dt>Error</dt>
                    <dd>@Request.ErrorDetail</dd>
                }
            </dl>

            <h4>Event history</h4>
            <ul class="event-list">
                @foreach (var evt in Request.Events)
                {
                    <li>
                        <span class="event-time">@evt.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                        <span class="event-source">[@evt.Source]</span>
                        <span class="event-status">@evt.StatusAtEvent</span>
                        @if (!string.IsNullOrEmpty(evt.Message))
                        {
                            <span class="event-message">— @evt.Message</span>
                        }
                    </li>
                }
            </ul>

            @if (_tableColumns is { Count: > 0 } columns && _tableRows is { Count: > 0 } rows)
            {
                var hasUserColumn = columns.Contains("sAMAccountName");

                <h4>Nəticələr (@rows.Count)</h4>
                <div class="result-table-scroll">
                    <table class="result-table">
                        <thead>
                            <tr>
                                @foreach (var col in columns)
                                {
                                    <th>@FriendlyColumnName(col)</th>
                                }
                                @if (hasUserColumn)
                                {
                                    <th>Əməliyyatlar</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr>
                                    @foreach (var col in columns)
                                    {
                                        <td>
                                            @{ var val = row.GetValueOrDefault(col, ""); }
                                            @if (col.Equals("enabled", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="status-badge @(val == "true" ? "status-succeeded" : "status-failed")">@(val == "true" ? "Aktiv" : "Deaktiv")</span>
                                            }
                                            else if (col.Equals("locked", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="status-badge @(val == "true" ? "status-failed" : "status-succeeded")">@(val == "true" ? "Kilidli" : "Açıq")</span>
                                            }
                                            else
                                            {
                                                @val
                                            }
                                        </td>
                                    }
                                    @if (hasUserColumn)
                                    {
                                        var username = row.GetValueOrDefault("sAMAccountName", "");
                                        <td class="row-actions">
                                            <button class="row-action-btn" title="Unlock" @onclick="() => HandleRowActionClick(AdActionType.Unlock, username)">🔓</button>
                                            <button class="row-action-btn" title="Enable" @onclick="() => HandleRowActionClick(AdActionType.Enable, username)">✅</button>
                                            <button class="row-action-btn" title="Disable" @onclick="() => HandleRowActionClick(AdActionType.Disable, username)">⛔</button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (!string.IsNullOrEmpty(Request.RawResultPayload))
            {
                <h4>Raw result payload</h4>
                <pre class="raw-payload">@Request.RawResultPayload</pre>
            }
        </div>
    </div>
}

@code {
    private AdActionRequest? _lastParsedRequest;
    private List<string>? _tableColumns;
    private List<Dictionary<string, string>>? _tableRows;

    [Parameter]
    public AdActionRequest? Request { get; set; }

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Raised when the user clicks Unlock/Enable/Disable on a search-result row.</summary>
    [Parameter]
    public EventCallback<(AdActionType ActionType, string Username)> OnRowAction { get; set; }

    private async Task HandleRowActionClick(AdActionType actionType, string username)
    {
        if (string.IsNullOrWhiteSpace(username))
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"{actionType}: {username}. Davam edilsin?");
        if (!confirmed)
        {
            return;
        }

        await OnRowAction.InvokeAsync((actionType, username));
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Request, _lastParsedRequest))
        {
            return;
        }

        _lastParsedRequest = Request;
        (_tableColumns, _tableRows) = TryBuildTable(Request?.RawResultPayload);
    }

    private static readonly Dictionary<string, string> FriendlyColumnNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["sAMAccountName"] = "İstifadəçi adı",
        ["enabled"] = "Status",
        ["locked"] = "Kilid",
        ["displayName"] = "Ad Soyad",
        ["title"] = "Vəzifə",
        ["department"] = "Şöbə",
        ["company"] = "Şirkət/Direktorluq",
        ["description"] = "Qeyd",
        ["mail"] = "E-poçt",
        ["userPrincipalName"] = "UPN",
        ["whenCreated"] = "Yaradılma tarixi",
    };

    private static string FriendlyColumnName(string col) => FriendlyColumnNames.GetValueOrDefault(col, col);

    /// <summary>Renders RawResultPayload as a table when it's a JSON array of flat objects
    /// (e.g. the n8n LDAP search results) — otherwise falls back to the raw-text view, since
    /// Jenkins/Azure Automation callbacks can send arbitrary free-form payloads.</summary>
    private static (List<string>? Columns, List<Dictionary<string, string>>? Rows) TryBuildTable(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return (null, null);
        }

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Array || doc.RootElement.GetArrayLength() == 0)
            {
                return (null, null);
            }

            var columns = new List<string>();
            var rows = new List<Dictionary<string, string>>();

            foreach (var item in doc.RootElement.EnumerateArray())
            {
                if (item.ValueKind != JsonValueKind.Object)
                {
                    return (null, null);
                }

                var row = new Dictionary<string, string>();
                foreach (var prop in item.EnumerateObject())
                {
                    if (!columns.Contains(prop.Name))
                    {
                        columns.Add(prop.Name);
                    }

                    row[prop.Name] = prop.Value.ValueKind switch
                    {
                        JsonValueKind.String => prop.Value.GetString() ?? "",
                        JsonValueKind.Null => "",
                        JsonValueKind.True => "true",
                        JsonValueKind.False => "false",
                        JsonValueKind.Array or JsonValueKind.Object => prop.Value.GetRawText(),
                        _ => prop.Value.GetRawText()
                    };
                }

                rows.Add(row);
            }

            return (columns, rows);
        }
        catch (JsonException)
        {
            return (null, null);
        }
    }
}
